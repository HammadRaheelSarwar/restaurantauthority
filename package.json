{
  "name": "restaurant-electrical-authority",
  "version": "1.0.0",
  "description": "Restaurant Electrical Authority (REA) - Complete Electrical Safety, Readiness & Compliance Management Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs');if(fs.existsSync('frontend/dist')&&!fs.existsSync('dist')){fs.cpSync('frontend/dist','dist',{recursive:true})}\"",
    "build:frontend": "npm --prefix frontend run build && node -e \"const fs=require('fs');if(fs.existsSync('frontend/dist')&&!fs.existsSync('dist')){fs.cpSync('frontend/dist','dist',{recursive:true})}\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "test:backend": "npm --prefix backend test"
  },
  "keywords": [
    "electrical-safety",
    "compliance",
    "restaurant-management",
    "supabase",
    "express",
    "react"
  ],
  "author": "Restaurant Electrical Authority",
  "license": "ISC"
}
